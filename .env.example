# Supabase — obtener en https://supabase.com/dashboard/project/<project_ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# hCaptcha invisible — obtener sitekey en https://dashboard.hcaptcha.com
# Kill-switch: si falta o es "PENDIENTE_SITEKEY", el CAPTCHA se desactiva en
# desarrollo (getToken() devuelve { status: "disabled" }). Safe en dev.
# Para producción: activar también en Supabase → Authentication → Attack Protection → CAPTCHA
NEXT_PUBLIC_HCAPTCHA_SITEKEY=PENDIENTE_SITEKEY

# NUNCA en el frontend — solo para scripts/admin server-side
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
# HCAPTCHA_SECRET_KEY=<secret_key>    ← va en Supabase, no aquí
